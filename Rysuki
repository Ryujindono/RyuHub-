-- 2. AUTOMATIC CORE DETECTORS
local function findParryRemote()
    local possibleNames = {"Parry", "ParryRemote", "Hit", "HitRemote", "ParryEvent", "HitEvent"}
    local places = {ReplicatedStorage, ReplicatedStorage:FindFirstChild("Remotes"), ReplicatedStorage:FindFirstChild("Events")}
    for _, folder in pairs(places) do
        if folder then
            for _, name in pairs(possibleNames) do
                local found = folder:FindFirstChild(name)
                if found and (found:IsA("RemoteEvent") or found:IsA("UnreliableRemoteEvent")) then return found end
            end
        end
    end
    return nil
end
local parryRemote = findParryRemote()

local function fetchBall()
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("BasePart") and (obj.Name:lower():find("ball") or obj:GetAttribute("Target") ~= nil) then return obj end
    end
    return nil
end

