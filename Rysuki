-- 5. ENGINE LOOP OPERATION
RunService.PreSimulation:Connect(function()
    if not RyuConfig.AutoParry then return end
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local ball = fetchBall()
    if not ball then return end
    
    local rawTarget = ball:GetAttribute("Target") or ball:GetAttribute("target") or ball:GetAttribute("player")
    local isBallTargetingMe = false
    
    if rawTarget then
        local targetStr = tostring(rawTarget)
        if targetStr == LocalPlayer.Name or targetStr == LocalPlayer.DisplayName or targetStr == tostring(LocalPlayer.UserId) then
            isBallTargetingMe = true
        end
    end
    
    if isBallTargetingMe then
        local myPosition = hrp.Position
        local ballPosition = ball.Position
        local ballVelocity = ball.AssemblyLinearVelocity
        
        local distance = (ballPosition - myPosition).Magnitude
        local speed = ballVelocity.Magnitude
        
        if RyuConfig.AutoSpam and distance <= RyuConfig.ClashDistance then
            local now = os.clock()
            if (now - lastSpamTime) >= RyuConfig.SpamDelay then
                lastSpamTime = now
                if parryRemote then parryRemote:FireServer() end
            end
            return
        end
        
        local ballDirection = ballVelocity.Unit
        local playerDirection = (myPosition - ballPosition).Unit
        local facingFactor = ballDirection:Dot(playerDirection)
        
        if facingFactor > 0.30 or distance <= RyuConfig.EmergencyDistance then
            if speed > 0 then
                local arrivalTime = distance / speed
                local networkPing = tonumber(LocalPlayer:GetPing()) or 0.045
                local parryThresholdWindow = (networkPing * RyuConfig.Accuracy) + 0.015
                
                if arrivalTime <= parryThresholdWindow or distance <= RyuConfig.EmergencyDistance then
                    if parryRemote then parryRemote:FireServer() end
                end
            end
        end
    end
end)

